; HAPPY VALLEY - recorridos (GDD 2.4.1): tramos de la salida a la meta. bends: bit k = el tramo k es
; curva. bk = factor de curva (prog -= ((spd >> 4) * (calle * bk)) >> 5).
@ table courses
@ prefix CRS
@ col track enum HV ST AW
@ col dist u16
@ col bk u8
@ col nseg u8
@ col m1 u16
@ col m2 u16
@ col m3 u16
@ col m4 u16
@ col m5 u16
@ col m6 u16
@ col bends u8
;id      track dist bk nseg m1   m2  m3  m4  m5  m6  bends
; todas en recta (el usuario: "solo una recta"); el modelo admite tramos y curvas si vuelven
HV800    HV    800  5  1    800  0   0   0   0   0   0
HV1000   HV    1000 5  1    1000 0   0   0   0   0   0
HV1200   HV    1200 5  1    1200 0   0   0   0   0   0
ST1000   ST    1000 4  1    1000 0   0   0   0   0   0
AW800    AW    800  5  1    800  0   0   0   0   0   0
AW1200   AW    1200 5  1    1200 0   0   0   0   0   0
