; FARO - system messages of the battle screen and menus (the kit composes them at run time; it has no
; text of its own). Placeholders: {S} = subject (Leo or the creature's name), {O} = object (item, move,
; technique or status text), {N} = number. The kit wraps them to the 18-character box lines.
; No accents or n-tilde (font). Row order is a rule table: the kit uses the MSG_* ids.
@ table msgs
@ prefix MSG
@ col t text 40
INTRO        "¡Un {S} salvaje!"
INTRO_AMBUSH "¡Te ataca un {S}!"
INTRO_ADV    "Lo pillas por sorpresa."
INTRO_SLEEP  "{S} duerme. No te ha visto."
USE_WEAPON   "Leo ataca con {O}."
USE_SKILL    "Leo usa {O}."
USE_ITEM     "Leo usa {O}."
USE_GADGET   "Leo usa {O}."
USE_MOVE     "{S} usa {O}."
MISS_P       "¡Fallas!"
MISS_C       "{S} falla."
HIT_C        "{S} pierde {N} PV."
HIT_P        "Leo pierde {N} PV."
CRIT         "¡Golpe critico!"
WEAK         "¡Es eficaz!"
RESIST       "Es poco eficaz..."
IMMUNE       "No le afecta."
STATUS       "{S} {O}."
STATUS_END   "{S} {O}."
SKIP         "{S} no se mueve."
DOT          "{S} sufre {N} PV."
HEAL         "{S} recupera {N} PV."
EN           "Leo recupera {N} EN."
REVEAL       "{S} tiene {N} PV."
AIM          "Leo apunta con calma."
DEBUFF_C     "{S} se acobarda."
DEBUFF_P     "Leo pierde fuerza."
DEFUP        "{S} se protege."
BUFF         "Te sientes con fuerzas."
BAIT_OK      "{S} se come el cebo."
BAIT_NO      "{S} no lo quiere."
THROW        "Lanzas el {O}."
SHAKE        "..."
CAPTURED     "¡{S} capturado!"
NEW_LIGHT    "¡Nueva luz para el faro!"
FAILED       "¡Se ha soltado!"
NOCOND       "La luz se escapa."
FLEE_OK      "Escapas sin problema."
FLEE_NO      "¡No puedes huir!"
C_FLEE       "{S} huye."
C_FLEE_NO    "{S} intenta huir."
STEAL        "{S} te roba {O}."
WATCH        "{S} te observa."
HUNTED       "{S} cae."
XP           "Ganas {N} PX."
LOOT         "Consigues {O} x{N}."
LEVEL        "¡Leo sube al Nv{N}!"
FAINTED      "Leo se desmaya..."
NO_LANTERN   "No te quedan farolillos."
NO_EN        "No tienes bastante EN."
NOTHING      "No tienes nada."
PANEL_SAC0   "Llena"
PANEL_SAC1   "Normal"
PANEL_SAC2   "Hambre"
PANEL_SAC3   "Debil"
PANEL_UNSAFE "No es seguro: hay algo cerca."
PANEL_NOHERE "Aqui no se puede acampar."
PANEL_NOWOOD "Te falta madera."
PANEL_SAVING "Guardando"
PANEL_SAVED  "Guardado"
PANEL_SOON   "Aun no esta hecho."
