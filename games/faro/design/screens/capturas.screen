/ font:SLASH
: font:COLON
< ui:FRAME_TL
= ui:FRAME_B
> ui:FRAME_TR
_ ui:FRAME_T
{ ui:FRAME_L
} ui:FRAME_R
δ uimenu:POCKET_LANTERNS
