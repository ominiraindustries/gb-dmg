( ui:FRAME_BL
* ui:CURSOR
: font:COLON
< ui:FRAME_TL
= ui:FRAME_B
? font:QUESTION
_ ui:FRAME_T
{ ui:FRAME_L
» uimenu:CURSOR_IDLE
¿ font_es:QUEST_OPEN
