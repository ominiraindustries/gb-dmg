; ESTADO - overlay like PAUSA: box cols 1-18, rows 1-10. Read-only (A / B / Start close).
; Title APRENDIZ row 2; stats rows 4-9. Labels at col 3; values right-aligned, right end = AT_x + LEN_x - 1 of each sample run.
tilesets: ui font font_lower
legend:
# AM_WALL
+ AM_UP
, AM_FLOOR
& ICON_HP
^ ICON_STAFF
$ ICON_AMULET
[ ICON_KEY
] ICON_POTION
@ ICON_COMPASS
/ DASH
: COLON
< FRAME_TL
_ FRAME_T
> FRAME_TR
{ FRAME_L
} FRAME_R
( FRAME_BL
= FRAME_B
) FRAME_BR
* CURSOR
- DASH
